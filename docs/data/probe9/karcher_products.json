03\/files\/KarcherWD3V174203.jpg?v=1771492986","width":1600,"height":1065},{"id":45564304785623,"created_at":"2026-02-19T14:23:04+05:00","position":5,"updated_at":"2026-02-19T14:23:06+05:00","product_id":9187712008407,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0702\/9935\/3303\/files\/KarcherWD3V174204.jpg?v=1771492986","width":1600,"height":1065},{"id":45564304818391,"created_at":"2026-02-19T14:23:04+05:00","position":6,"updated_at":"2026-02-19T14:23:06+05:00","product_id":9187712008407,"variant_ids":[],"src":"https:\/\/cdn.shopify.com\/s\/files\/1\/0702\/9935\/3303\/files\/KarcherWD3V174205.jpg?v=1771492986","width":1600,"height":2399}],"options":[{"name":"Title","position":1,"values":["Default Title"]}]},{"id":9267375603927,"title":"Катушка со шлангом из пластмассы атомати HBX 4.20 автоматический","handle":"katushka-so-shlangom-iz-plastmassy-atomati-hbx-4-20-avtomaticheskiy","body_html":"\u003cdiv class=\"row\" id=\"description\" data-anchor=\"Description\"\u003e\n\u003cdiv class=\"col-sm-12\"\u003e\n\u003cp\u003e\u003cspan dir=\"auto\"\u003eИдеальное хранение: стильный ящик для шланга крепится на стену для экономии места и подключается к крану с помощью соединительного шланга. Благодаря настенному кронштейну ящик для шланга можно поворачивать более чем на 180°, что позволяет легко дотянуться шлангом до любого уголка сада. Садовый шланг легко удлиняется до максимальной длины 20 метров. Предусмотрены соответствующие этапы фиксации: шланг автоматически фиксируется с короткими интервалами. Легкое потягивание за конец шланга освобождает механизм фиксации, благодаря чему шланг автоматически и контролируемо сматывается, без перегибов и узлов. Благодаря инновационной системе крепления FlexChange ящик для шланга можно снять с настенного кронштейна без использования каких-либо инструментов. Это идеально подходит для удобного хранения зимой или для гибкого использования между настенным кронштейном и штырем для шланга, который доступен в качестве дополнительного аксессуара. Ящик для шланга также устойчив к ультрафиолетовому излучению и морозостоек, поэтому его можно хранить на стене дома круглый год. Для защиты от кражи можно установить тросовый замок. Компания Kärcher предоставляет пятилетнюю гарантию на свою продукцию.\u003c\/span\u003e\u003c\/p\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv id=\"featurebenefits\" data-anchor=\"Features and benefits\"\u003e\n\u003ch5 class=\"section-headline\"\u003e\u003cspan dir=\"auto\"\u003eОсобенности и преимущества\u003c\/span\u003e\u003c\/h5\u003e\n\u003cdiv class=\"row\"\u003e\n\u003cdiv class=\"col-sm-4 image-fit\"\u003e\n\u003cimg alt=\"HBX 4.20 Автоматический: FlexChange\" src=\"https:\/\/s1.kaercher-media.com\/images\/pim\/31c8d453-69dd-4744-a307-277e6504231c.jpg\"\u003e\n\u003ch6 class=\"headlinebottom\"\u003e\u003cspan dir=\"auto\"\u003eFlexChange\u003c\/span\u003e\u003c\/h6\u003e\n\u003cspan dir=\"auto\"\u003eНикаких винтов, никаких инструментов, никаких усилий: благодаря уникальной системе Kärcher FlexChange, коробку для шланга можно снять с настенного кронштейна или штыря за считанные секунды (например, зимой).\u003c\/span\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"col-sm-4 image-fit\"\u003e\n\u003cimg alt=\"HBX 4.20 Автоматический: Практичный держатель форсунки\" src=\"https:\/\/s1.kaercher-media.com\/images\/pim\/e1d2748c-0807-4442-b75c-c0cb66e42fb2.jpg\"\u003e\n\u003ch6 class=\"headlinebottom\"\u003e\u003cspan dir=\"auto\"\u003eПрактичный держатель насадки\u003c\/span\u003e\u003c\/h6\u003e\n\u003cspan dir=\"auto\"\u003eНасадки и распылительные трубки можно повесить на настенный кронштейн для удобного хранения.\u003c\/span\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"col-sm-4 image-fit\"\u003e\n\u003cimg alt=\"HBX 4.20 Автоматический: Хранение шланга\" src=\"https:\/\/s1.kaercher-media.com\/images\/pim\/ca55b23f-5ae3-4676-89da-647f1b5326ab.jpg\"\u003e\n\u003ch6 class=\"headlinebottom\"\u003e\u003cspan dir=\"auto\"\u003eХранение шлангов\u003c\/span\u003e\u003c\/h6\u003e\n\u003cspan dir=\"auto\"\u003eСлегка потяните за конец шланга, и механизм втягивания шланга автоматически полностью втянет его. Максимальный комфорт без узлов, запутывания и загрязнения рук.\u003c\/span\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"row\"\u003e\n\u003cdiv class=\"col-sm-12\"\u003e\n\u003cdiv class=\"row fc-featurebenefits-row\"\u003e\n\u003cdiv class=\"col-sm-5\"\u003e\n\u003ch6\u003e\u003cspan dir=\"auto\"\u003eВыход для шланга расположен на нижней стороне коробки.\u003c\/span\u003e\u003c\/h6\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"col-sm-7 col-no-padding\"\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan dir=\"auto\"\u003eДля лучшей защиты от непогоды и увеличения срока службы.\u003c\/span\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"row fc-featurebenefits-row\"\u003e\n\u003cdiv class=\"col-sm-5\"\u003e\n\u003ch6\u003e\u003cspan dir=\"auto\"\u003eНастенный бокс для шланга с возможностью поворота на 180°\u003c\/span\u003e\u003c\/h6\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"col-sm-7 col-no-padding\"\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan dir=\"auto\"\u003eУстановленный на настенном кронштейне, бокс для шланга может поворачиваться более чем на 180°. Это обеспечивает максимальную свободу движений при поливе сада, предотвращая перегибы шланга.\u003c\/span\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"row fc-featurebenefits-row\"\u003e\n\u003cdiv class=\"col-sm-5\"\u003e\n\u003ch6\u003e\u003cspan dir=\"auto\"\u003eПрочный и съемный настенный кронштейн\u003c\/span\u003e\u003c\/h6\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"col-sm-7 col-no-padding\"\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan dir=\"auto\"\u003eИспользование прочных материалов с металлическим сердечником обеспечивает долговечность и устойчивость. Особенно практично: съемный настенный кронштейн гарантирует, что вы не застрянете.\u003c\/span\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"row fc-featurebenefits-row\"\u003e\n\u003cdiv class=\"col-sm-5\"\u003e\n\u003ch6\u003e\u003cspan dir=\"auto\"\u003eВстроенный шланговый тормоз\u003c\/span\u003e\u003c\/h6\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"col-sm-7 col-no-padding\"\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan dir=\"auto\"\u003eСистема автоматического втягивания шланга сочетается с тормозом шланга, благодаря чему шланг автоматически и контролируемо, медленно сматывается обратно в короб для шлангов. \u003c\/span\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"row fc-featurebenefits-row\"\u003e\n\u003cdiv class=\"col-sm-5\"\u003e\n\u003ch6\u003e\u003cspan dir=\"auto\"\u003eВстроенный направляющий шланг\u003c\/span\u003e\u003c\/h6\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"col-sm-7 col-no-padding\"\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan dir=\"auto\"\u003eБез перегибов и узлов: шланг равномерно натягивается и направляется. \u003c\/span\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"row fc-featurebenefits-row\"\u003e\n\u003cdiv class=\"col-sm-5\"\u003e\n\u003ch6\u003e\u003cspan dir=\"auto\"\u003eЭргономичная ручка для переноски\u003c\/span\u003e\u003c\/h6\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"col-sm-7 col-no-padding\"\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan dir=\"auto\"\u003eЭргономичная ручка позволяет легко переносить коробку со шлангом одной рукой.\u003c\/span\u003e\u003c\/li\u003e\n\u003c\/ul\u003e\n\u003c\/div\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"row fc-featurebenefits-row\"\u003e\n\u003cdiv class=\"col-sm-5\"\u003e\n\u003ch6\u003e\u003cspan dir=\"auto\"\u003eГотов к немедленному применению.\u003c\/span\u003e\u003c\/h6\u003e\n\u003c\/div\u003e\n\u003cdiv class=\"col-sm-7 col-no-padding\"\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cspan dir=\"auto\"\u003eВ комплект 