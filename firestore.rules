rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in (anonymous) visitor can read/write ONLY their own profile,
    // so nobody can read anyone else's phone number. The project owner sees all
    // users in the Firebase console. The Cloudflare Worker uses the Admin service
    // account, which bypasses these rules, so bot collections keep working.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'city', 'brands', 'since', 'lang', 'watch', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20;
      allow delete: if false;
    }
    // Everything else (site_reg with phone numbers, tg_users, bot state, ...) is
    // closed to all browser/client access; only the Worker's service account writes it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
